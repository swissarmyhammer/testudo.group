<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sparkle update feed of OpenTestudo: https://testudo.group/appcast.xml
  The release ("Scripts/xcodebuild-app.sh notarize", which
  .github/workflows/release.yml runs) adds one <item> for each release with
  "release-tool appcast-item": the version, the URL of the notarized zip in
  /downloads, its length and its EdDSA signature (sparkle:edSignature). Do not
  add items by hand.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>OpenTestudo</title>
    <link>https://testudo.group/appcast.xml</link>
    <description>Updates of OpenTestudo.</description>
    <language>en</language>
  </channel>
</rss>
